# Runtime: use development/test locally and production/staging on deployed servers.
# Production must run behind an HTTPS reverse proxy with HSTS and without debug/reload mode.
TRADE_PAPER_ENV=development

# Required in production/staging. Generate a stable random value with at least 32 characters.
TRADE_PAPER_SESSION_SECRET=

# Required in production/staging. JSON storage supports exactly one application worker.
TRADE_PAPER_DATA_DIR=./data
WEB_CONCURRENCY=1

# Optional cross-origin browser clients. Use comma-separated explicit origins; never use *.
TRADE_PAPER_CORS_ORIGINS=

# Development may use false. Production/staging always force Secure session cookies.
TRADE_PAPER_SESSION_COOKIE_SECURE=false

# Email delivery: disabled is the safe default. API is reserved for a future provider adapter.
TRADE_PAPER_EMAIL_BACKEND=disabled

# Required when email delivery is enabled. Production/staging require an HTTPS origin.
TRADE_PAPER_PUBLIC_BASE_URL=
TRADE_PAPER_EMAIL_FROM_ADDRESS=
TRADE_PAPER_EMAIL_FROM_NAME=Trade Paper AI
TRADE_PAPER_EMAIL_REPLY_TO=
TRADE_PAPER_EMAIL_TIMEOUT_SECONDS=5

# Optional customer-facing Contact page values. Existing reply-to/from and public URL
# settings are reused when these dedicated values are empty.
TRADE_PAPER_CONTACT_EMAIL=
TRADE_PAPER_CONTACT_URL=

# Required only for the SMTP backend. Production/staging require STARTTLS=true.
TRADE_PAPER_SMTP_HOST=
TRADE_PAPER_SMTP_PORT=587
TRADE_PAPER_SMTP_USERNAME=
TRADE_PAPER_SMTP_PASSWORD=
TRADE_PAPER_SMTP_STARTTLS=true
